# This file was generated using idf.py save-defconfig. It can be edited manually.

# 1. Use SDKConfiguration editor to edit the configuration
#    Then run "idf.py save-defconfig" to update sdkconfig.defaults
#    I will use tool to diff, and add comment as the file below
#
# 2. After editing this file, run "idf.py reconfigure" to update sdkconfig
#    which is used during build procedure
#
# 3. If everything works well, submit this file into git

# Select Target
CONFIG_IDF_TARGET="esp32c3"

# Configure HTTPD WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y

# Configure FATFS Long-File-Name store in heap
CONFIG_FATFS_LFN_HEAP=y

# Enable custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Set the flash size to 4MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# HTTP Server buffer tuning for larger headers/payload handling
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Enable BLE (NimBLE stack)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
